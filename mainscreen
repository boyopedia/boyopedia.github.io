<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Boyopedia — Cargando…</title>
  <meta name="description" content="Pantalla de carga infinita para Boyopedia" />
  <style>
    :root{
      --bg1: #0f1724;
      --bg2: #071028;
      --accent: #5eead4; /* mint */
      --accent-2: #60a5fa; /* blue */
      --loader-size: 120px;
      --dot-size: 14px;
    }

    /* Full-screen layout */
    html,body{
      height:100%;
      margin:0;
      font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      background: radial-gradient(1200px 600px at 10% 10%, rgba(96,165,250,0.06), transparent),
                  linear-gradient(120deg, var(--bg1) 0%, var(--bg2) 100%);
      color: #e6eef6;
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
    }

    .loading-frame{
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:24px;
      box-sizing:border-box;
    }

    .panel{
      text-align:center;
      max-width:720px;
      width:100%;
      backdrop-filter: blur(6px) saturate(120%);
      padding:28px;
      border-radius:14px;
      background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
      box-shadow: 0 10px 30px rgba(2,6,23,0.6), inset 0 1px 0 rgba(255,255,255,0.02);
    }

    h1{
      margin:0 0 12px;
      font-weight:600;
      font-size:20px;
      letter-spacing:0.2px;
    }

    p.lead{
      margin:0 0 20px;
      font-size:14px;
      color:rgba(230,238,246,0.85);
    }

    /* Loader */
    .loader{
      width:var(--loader-size);
      height:var(--loader-size);
      margin:0 auto 14px;
      position:relative;
      display:block;
    }

    /* central ring */
    .ring{
      position:absolute;
      inset:0;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      box-shadow: 0 0 40px rgba(96,165,250,0.06), inset 0 0 18px rgba(94,234,212,0.03);
      transform: rotate(0deg);
      animation: spin 3.6s linear infinite;
    }

    .ring::before{
      content:"";
      width:76%;
      height:76%;
      border-radius:50%;
      background: radial-gradient(circle at 30% 20%, rgba(96,165,250,0.06), transparent 30%),
                  linear-gradient(180deg, rgba(255,255,255,0.02), transparent 60%);
      box-shadow: inset 0 6px 20px rgba(2,6,23,0.45);
    }

    /* orbiting dots */
    .dot{
      --r: calc(var(--loader-size) / 2 - var(--dot-size));
      width:var(--dot-size);
      height:var(--dot-size);
      border-radius:50%;
      position:absolute;
      left:50%;
      top:50%;
      margin:-0.5 * var(--dot-size); /* fallback, we'll adjust with transform */
      transform-origin: center calc(var(--r));
      background: radial-gradient(circle at 30% 25%, #fff 0%, rgba(255,255,255,0.9) 10%, transparent 70%),
                  conic-gradient(var(--accent), var(--accent-2));
      box-shadow: 0 6px 20px rgba(96,165,250,0.18), 0 1px 0 rgba(255,255,255,0.06);
      filter: drop-shadow(0 6px 10px rgba(2,6,23,0.6));
    }

    /* create several dots rotated around the ring */
    .dot:nth-child(1){ transform: rotate(0deg)   translateY(calc(-1 * var(--r))); animation: orbit 1.6s linear infinite; }
    .dot:nth-child(2){ transform: rotate(60deg)  translateY(calc(-1 * var(--r))); animation: orbit 1.9s linear infinite; animation-delay: -0.2s;}
    .dot:nth-child(3){ transform: rotate(120deg) translateY(calc(-1 * var(--r))); animation: orbit 1.7s linear infinite; animation-delay: -0.4s;}
    .dot:nth-child(4){ transform: rotate(180deg) translateY(calc(-1 * var(--r))); animation: orbit 1.8s linear infinite; animation-delay: -0.6s;}
    .dot:nth-child(5){ transform: rotate(240deg) translateY(calc(-1 * var(--r))); animation: orbit 1.65s linear infinite; animation-delay: -0.8s;}
    .dot:nth-child(6){ transform: rotate(300deg) translateY(calc(-1 * var(--r))); animation: orbit 1.85s linear infinite; animation-delay: -1s;}

    /* subtle pulsing center */
    .core{
      width:26%;
      height:26%;
      border-radius:50%;
      background: linear-gradient(180deg, rgba(94,234,212,0.16), rgba(96,165,250,0.06));
      box-shadow: 0 6px 24px rgba(94,234,212,0.06), inset 0 1px 0 rgba(255,255,255,0.03);
      animation: pulse 2.8s ease-in-out infinite;
    }

    /* Text small spinner for assistive tech */
    .sr-only{
      position:absolute;
      width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;
    }

    /* animations */
    @keyframes spin{
      0%{ transform: rotate(0deg); }
      100%{ transform: rotate(360deg); }
    }

    @keyframes orbit{
      0%{ transform: rotate(var(--start,0deg)) translateY(calc(-1 * var(--r))) scale(0.9); opacity:0.85; }
      50%{ transform: rotate(calc(var(--start,0deg) + 180deg)) translateY(calc(-1 * var(--r))) scale(1.08); opacity:1; }
      100%{ transform: rotate(calc(var(--start,0deg) + 360deg)) translateY(calc(-1 * var(--r))) scale(0.92); opacity:0.85; }
    }

    @keyframes pulse{
      0%{ transform: scale(1); opacity:0.95; }
      50%{ transform: scale(1.08); opacity:1; }
      100%{ transform: scale(1); opacity:0.95; }
    }

    /* small screens */
    @media (max-width:480px){
      :root{ --loader-size: 88px; --dot-size: 12px; }
      h1{ font-size:18px; }
    }

    /* respects user's motion preferences */
    @media (prefers-reduced-motion: reduce){
      .ring, .dot, .core{ animation: none !important; transition: none !important; }
    }

  </style>
</head>
<body>
  <div class="loading-frame" role="status" aria-live="polite" aria-label="Cargando contenido">
    <div class="panel" aria-hidden="false">
      <h1>Boyopedia</h1>
      <p class="lead">Cargando la enciclopedia oficial de los Boyos. Esto puede tardar unos instantes…</p>

      <div class="loader" aria-hidden="true">
        <div class="ring" aria-hidden="true">
          <div class="core" aria-hidden="true"></div>
          <span class="dot" style="--start: 0deg;"></span>
          <span class="dot" style="--start: 60deg;"></span>
          <span class="dot" style="--start: 120deg;"></span>
          <span class="dot" style="--start: 180deg;"></span>
          <span class="dot" style="--start: 240deg;"></span>
          <span class="dot" style="--start: 300deg;"></span>
        </div>
      </div>

      <div style="font-size:13px; color: rgba(230,238,246,0.7);">
        <span>Cargando…</span>
      </div>

      <p class="sr-only">Cargando la enciclopedia. Por favor espere.</p>
    </div>
  </div>

  <script>
    // Optional: Keep the page interactive and accessible.
    // This script does not control animation; it only logs and keeps focus for screen readers.
    (function(){
      // Announce once for screen readers (edge-case support)
      const status = document.querySelector('[role="status"]');
      let announced = false;
      function announceOnce(){
        if(announced) return;
        announced = true;
        // update visually-hidden text briefly to trigger some AT
        const sr = document.querySelector('.sr-only');
        if(!sr) return;
        const prev = sr.textContent;
        sr.textContent = prev + " ";
        setTimeout(()=> sr.textContent = prev, 1000);
      }
      // announce after DOM ready
      if(document.readyState === 'complete' || document.readyState === 'interactive'){
        announceOnce();
      } else {
        window.addEventListener('DOMContentLoaded', announceOnce, {once:true});
      }

      // Prevent accidental long tasks from freezing the UI: keep a small heartbeat
      let last = performance.now();
      setInterval(() => { last = performance.now(); }, 1000);
    })();
  </script>
</body>
</html>
